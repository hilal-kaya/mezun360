# Local development only. Copy to .env and choose a local password.
POSTGRES_DB=mezun360
POSTGRES_USER=mezun360
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Explicit local demo opt-in. Set true before running scripts/setup-dev-users.py.
DEV_USERS_ENABLED=false
# The setup script fills missing/empty values with synthetic addresses/random passwords.
DEV_ALUMNI_EMAIL=
DEV_ALUMNI_PASSWORD=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
# Local profile supplies HTTP cookie/MFA defaults; never use it for production.
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_NAME=mezun360-session
# ADMIN_MFA_REQUIRED=false
# AUTH_ALLOWED_ORIGINS= (empty uses same-origin proxy)
